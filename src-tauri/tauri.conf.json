{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zastava",
  "version": "2.1.0-1",
  "identifier": "io.zastava.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Zastava",
        "width": 460,
        "height": 660,
        "minWidth": 420,
        "minHeight": 580,
        "resizable": true,
        "decorations": true,
        "center": true,
        "visible": false
      },
      {
        "label": "alert-popup",
        "title": "Zastava Alert",
        "url": "index.html?window=alert-popup",
        "width": 440,
        "height": 360,
        "resizable": false,
        "alwaysOnTop": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "center": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost https://api.github.com"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "zastava"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE0QjJEMDA1QzQ5MjEwNUEKUldSYUVKTEVCZEN5cEE5R1JsaWFnbFVoWi9hRmExZExpTUpiaGdadjZ2ZTJ3a1R3MzUxMy91SkkK",
      "endpoints": [
        "https://github.com/kingbest1195/ai-antiban/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
